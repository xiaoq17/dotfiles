[user]
	name = Qin Xiao
	email = xiaoqin.7@bytedance.com
[color]
	ui = true
[alias]
	# status / log
	st = status -sb
	lg = log --graph --oneline --decorate
	last = show --stat --oneline HEAD
	recent = for-each-ref --sort=-committerdate refs/heads/ --format='%(committerdate:short) %(refname:short)'
	# workflow
	sync = pull --rebase --autostash
	amend = commit --amend --no-edit
	unstage = reset -q HEAD --
	wip = !git add -A && git commit -q -m WIP
	unwip = reset --soft HEAD~1
	# delete merged local branches (protected: master/main), prune remotes
	purge = "!git fetch -p && for b in $(git branch --merged | grep -vE '^\\*|master|main' | tr -d ' '); do git branch -d \"$b\"; done"
[core]
	editor = vim
	excludesfile = ~/.gitignore_global
[push]
	default = simple
[filter "lfs"]
	clean = git lfs clean %f
	smudge = git lfs smudge %f
	required = true
[github]
	user = xiaoq17
[ghi]
	token = !security find-internet-password -a xiaoq17 -s github.com -l 'ghi token' -w
[safe]
	directory = *
